# RPC endpoint for the Sepolia testnet (Infura, Alchemy, ...)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_API_KEY


# Address that ends up owning both contracts (transferOwnership) and receives
# the 1,000,000 test CTF tokens + 100 test ETH on local nodes.
# Leave empty to use the deployer address.
OWNER_ADDRESS=

# Treasury address that receives the non-burned part of every NFT sale.
# Leave empty to use the owner address.
TREASURY_ADDRESS=

# Optional: for `npx hardhat verify`
ETHERSCAN_API_KEY=

# Optional: amount of test tokens minted to the deployer (default 1000000)
TEST_TOKEN_AMOUNT=1000000


