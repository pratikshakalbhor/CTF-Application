# Which network the UI targets: "localhost" (default) or "sepolia"
VITE_CHAIN=localhost

# --- Sepolia only (used when VITE_CHAIN=sepolia) ---
VITE_SEPOLIA_TOKEN_ADDRESS=
VITE_SEPOLIA_NFT_ADDRESS=
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Block the contracts were deployed at (speeds up the activity log scan)
VITE_SEPOLIA_DEPLOY_BLOCK=

# --- Optional tweaks ---
# Auto refresh interval in ms (default 15000)
VITE_REFRESH_MS=15000
# How many past blocks to scan for the activity log on non-local networks
VITE_ACTIVITY_LOOKBACK=5000
# IPFS gateway used to resolve ipfs:// URIs
VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/
